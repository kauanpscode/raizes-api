{
    "openapi": "3.0.0",
    "info": {
        "title": "API Raízes do Nordeste",
        "description": "Documentação da API para o Projeto Multidisciplinar Back-End",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api",
            "description": "Servidor Local"
        }
    ],
    "paths": {
        "/auditoria/logs": {
            "get": {
                "tags": [
                    "Auditoria & Logs"
                ],
                "summary": "Consultar trilha de auditoria e rastreabilidade da franquia",
                "description": "Lista o histórico de operações sensíveis executadas no sistema (criação de pedidos, pagamentos mock aprovados/recusados, mudanças de status, consentimentos LGPD) para fins de governança e conformidade.",
                "operationId": "7933cfc6c4491b9bb06b4e1a46c7496b",
                "parameters": [
                    {
                        "name": "entidade",
                        "in": "query",
                        "description": "Filtrar por entidade (ex: pedidos, pagamentos, consentimentos_lgpd)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "pedidos"
                        }
                    },
                    {
                        "name": "acao",
                        "in": "query",
                        "description": "Filtrar por ação sensível (ex: CRIAR_PEDIDO, PAGAMENTO_APROVADO, MUDAR_STATUS_PEDIDO)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "PAGAMENTO_APROVADO"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Quantidade máxima de registros retornados (padrão: 50)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Trilha de auditoria recuperada com sucesso"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Autenticar usuário",
                "description": "Valida as credenciais e retorna o token de acesso com o perfil do usuário.",
                "operationId": "c542ba0f20b129ebb73c48d9561d560b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "senha"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@raizesdonordeste.com.br"
                                    },
                                    "senha": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Admin@123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso e token gerado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "accessToken": {
                                            "type": "string",
                                            "example": "eyJhbGciOi..."
                                        },
                                        "tokenType": {
                                            "type": "string",
                                            "example": "Bearer"
                                        },
                                        "expiresIn": {
                                            "type": "integer",
                                            "example": 3600
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "nome": {
                                                    "type": "string",
                                                    "example": "Dona Francisca"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "admin@raizesdonordeste.com.br"
                                                },
                                                "id_perfil": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "perfil": {
                                                    "type": "string",
                                                    "example": "ADMIN"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciais inválidas"
                    },
                    "422": {
                        "description": "Campos obrigatórios ausentes"
                    }
                }
            }
        },
        "/auth/dados": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Obter dados do usuário autenticado via Bearer Token",
                "operationId": "d6f5531f7d7e759ef96f8216549b70df",
                "responses": {
                    "200": {
                        "description": "Dados do usuário autenticado"
                    },
                    "401": {
                        "description": "Token não informado ou inválido"
                    }
                }
            }
        },
        "/lgpd/consentimento": {
            "post": {
                "tags": [
                    "LGPD & Privacidade"
                ],
                "summary": "Registrar consentimento explícito do titular (Conformidade LGPD)",
                "description": "Registra a manifestação livre, informada e inequívoca do titular para tratamento de dados cadastrais e programa de fidelização conforme a Lei Geral de Proteção de Dados (Lei nº 13.709/2018).",
                "operationId": "200dc15d8b7cc78103a9bb83d3a256d2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "usuarioId",
                                    "aceitou"
                                ],
                                "properties": {
                                    "usuarioId": {
                                        "description": "ID do usuário titular dos dados",
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "aceitou": {
                                        "description": "Aceite formal dos termos",
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "termoVersao": {
                                        "description": "Versão do termo de privacidade",
                                        "type": "string",
                                        "example": "v1.0"
                                    },
                                    "canal": {
                                        "description": "Canal de coleta (APP, TOTEM, WEB, BALCAO)",
                                        "type": "string",
                                        "example": "APP"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Consentimento registrado com sucesso no banco de dados"
                    },
                    "404": {
                        "description": "Usuário não encontrado"
                    },
                    "422": {
                        "description": "Campos obrigatórios ausentes"
                    }
                }
            }
        },
        "/pagamentos/mock": {
            "post": {
                "tags": [
                    "Pagamentos"
                ],
                "summary": "Processar pagamento simulado",
                "description": "Simula o envio de cobrança a um provedor externo de pagamentos.",
                "operationId": "5b3b2ed1cf3bd583687831a2e8f1954f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "pedidoId"
                                ],
                                "properties": {
                                    "pedidoId": {
                                        "description": "ID do pedido a ser pago",
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "metodo": {
                                        "description": "PIX, CARTAO_CREDITO, CARTAO_DEBITO, DINHEIRO",
                                        "type": "string",
                                        "example": "PIX"
                                    },
                                    "simulacao": {
                                        "description": "APROVADO ou RECUSADO",
                                        "type": "string",
                                        "example": "APROVADO"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Pagamento aprovado e status do pedido atualizado para PAGO"
                    },
                    "404": {
                        "description": "Pedido não encontrado"
                    },
                    "409": {
                        "description": "Pagamento recusado pela operadora ou pedido já pago/cancelado"
                    },
                    "422": {
                        "description": "Campos obrigatórios ausentes ou método inválido"
                    }
                }
            }
        },
        "/pedidos": {
            "get": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Listar pedidos",
                "description": "Lista pedidos com opção de filtro por canal de atendimento e status.",
                "operationId": "833aad5dcc2d45363bb6cfbcce5e55fa",
                "parameters": [
                    {
                        "name": "canalPedido",
                        "in": "query",
                        "description": "Filtrar por canal de origem (APP, TOTEM, BALCAO, PICKUP, WEB)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "TOTEM"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filtrar por status do pedido (AGUARDANDO_PAGAMENTO, PAGO, EM_PREPARO, PRONTO, ENTREGUE, CANCELADO)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "AGUARDANDO_PAGAMENTO"
                        }
                    },
                    {
                        "name": "unidadeId",
                        "in": "query",
                        "description": "Filtrar por unidade física",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de pedidos recuperada com sucesso"
                    }
                }
            },
            "post": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Criar novo pedido",
                "description": "Valida regras de negócio, verifica o estoque por unidade, valida o campo obrigatório canalPedido e cria o pedido com status AGUARDANDO_PAGAMENTO.",
                "operationId": "73b5161a3d2661603f3cf7c7ec92b4b8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "canalPedido",
                                    "unidadeId",
                                    "itens"
                                ],
                                "properties": {
                                    "canalPedido": {
                                        "description": "Valores: APP, TOTEM, BALCAO, PICKUP, WEB",
                                        "type": "string",
                                        "example": "TOTEM"
                                    },
                                    "unidadeId": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "usuarioId": {
                                        "type": "integer",
                                        "example": 5,
                                        "nullable": true
                                    },
                                    "formaPagamento": {
                                        "type": "string",
                                        "example": "PIX"
                                    },
                                    "observacoes": {
                                        "type": "string",
                                        "example": "Sem cebola"
                                    },
                                    "itens": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "produtoId": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "quantidade": {
                                                    "type": "integer",
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pedido criado com sucesso"
                    },
                    "404": {
                        "description": "Unidade ou Produto não encontrado"
                    },
                    "409": {
                        "description": "Estoque insuficiente para um ou mais itens"
                    },
                    "422": {
                        "description": "Dados obrigatórios ausentes ou inválidos"
                    }
                }
            }
        },
        "/pedidos/{id}": {
            "get": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Detalhes de um pedido específico e seus itens",
                "operationId": "002f94f77f0e133da66582bdb7fcf80c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do pedido",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pedido e itens localizados"
                    },
                    "404": {
                        "description": "Pedido não encontrado"
                    }
                }
            }
        },
        "/pedidos/{id}/status": {
            "patch": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Atualizar ciclo de status do pedido",
                "description": "Atualiza o status do pedido (PAGO, EM_PREPARO, PRONTO, ENTREGUE, CANCELADO) e registra log de auditoria.",
                "operationId": "be88bf0513956c88480059932448715f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do pedido",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "status"
                                ],
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "example": "EM_PREPARO"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status atualizado com sucesso"
                    },
                    "404": {
                        "description": "Pedido não encontrado"
                    },
                    "422": {
                        "description": "Status inválido ou não permitido"
                    }
                }
            }
        },
        "/produtos": {
            "get": {
                "tags": [
                    "Produtos"
                ],
                "summary": "Listar cardápio de produtos da franquia",
                "description": "Retorna a lista de produtos regionais ativos, permitindo filtro opcional por categoria ou por unidade.",
                "operationId": "81ac3087c03f300c905934ce8c4cba2a",
                "parameters": [
                    {
                        "name": "categoria",
                        "in": "query",
                        "description": "Filtrar por categoria (ex: Cuscuz, Tapiocas, Sobremesas, Bebidas, Juninos)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "Cuscuz"
                        }
                    },
                    {
                        "name": "unidadeId",
                        "in": "query",
                        "description": "Filtrar produtos disponíveis no estoque de uma unidade específica",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cardápio recuperado com sucesso"
                    }
                }
            }
        },
        "/produtos/{id}": {
            "get": {
                "tags": [
                    "Produtos"
                ],
                "summary": "Detalhes de um produto específico",
                "description": "Busca os dados de um item do cardápio pelo ID. Retorna 404 se não for encontrado.",
                "operationId": "0aa34fea1148a8fca2c7eb666226e97d",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID numérico do produto",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Produto localizado com sucesso"
                    },
                    "404": {
                        "description": "Produto não encontrado"
                    }
                }
            }
        },
        "/unidades": {
            "get": {
                "tags": [
                    "Unidades"
                ],
                "summary": "Listar todas as unidades da franquia",
                "description": "Retorna a lista de unidades ativas.",
                "operationId": "bdedabec87a330bac1c5495c1e4094c7",
                "parameters": [
                    {
                        "name": "uf",
                        "in": "query",
                        "description": "Filtrar unidades por UF",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "PE"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de unidades retornada com sucesso"
                    }
                }
            },
            "post": {
                "tags": [
                    "Unidades"
                ],
                "summary": "Cadastrar nova unidade",
                "description": "Cadastra uma nova filial no sistema. Exige código, nome fantasia, CNPJ, cidade e UF.",
                "operationId": "75ac4a9b4a40d7fbc4d1bf4e22490eb7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "codigo",
                                    "nome_fantasia",
                                    "cnpj",
                                    "cidade",
                                    "uf"
                                ],
                                "properties": {
                                    "codigo": {
                                        "type": "string",
                                        "example": "NAT-01"
                                    },
                                    "nome_fantasia": {
                                        "type": "string",
                                        "example": "Raízes do Nordeste - Filial Natal"
                                    },
                                    "razao_social": {
                                        "type": "string",
                                        "example": "Raizes Natal Lanchonete Ltda"
                                    },
                                    "cnpj": {
                                        "type": "string",
                                        "example": "12345678000433"
                                    },
                                    "cidade": {
                                        "type": "string",
                                        "example": "Natal"
                                    },
                                    "uf": {
                                        "type": "string",
                                        "example": "RN"
                                    },
                                    "tipo_unidade": {
                                        "type": "string",
                                        "example": "FILIAL"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Unidade cadastrada com sucesso"
                    },
                    "409": {
                        "description": "Código ou CNPJ já cadastrado"
                    },
                    "422": {
                        "description": "Campos obrigatórios ausentes"
                    }
                }
            }
        },
        "/unidades/{id}": {
            "get": {
                "tags": [
                    "Unidades"
                ],
                "summary": "Detalhes de uma unidade específica",
                "description": "Busca os dados de uma unidade pelo ID.",
                "operationId": "4c1255e82c383a60d12bbbce82f5480a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID da unidade",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Unidade localizada com sucesso"
                    },
                    "404": {
                        "description": "Unidade não encontrada"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Auditoria & Logs",
            "description": "Auditoria & Logs"
        },
        {
            "name": "Autenticação",
            "description": "Autenticação"
        },
        {
            "name": "LGPD & Privacidade",
            "description": "LGPD & Privacidade"
        },
        {
            "name": "Pagamentos",
            "description": "Pagamentos"
        },
        {
            "name": "Pedidos",
            "description": "Pedidos"
        },
        {
            "name": "Produtos",
            "description": "Produtos"
        },
        {
            "name": "Unidades",
            "description": "Unidades"
        }
    ]
}